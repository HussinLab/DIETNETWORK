# Copy to `.env` for local docker-compose use. In production these values
# come from Pulumi encrypted config, injected by cloud-init -- see
# infra/__main__.py and DEPLOYMENT.md. Never commit a real .env.

# --- Domain / TLS ---
DOMAIN=localhost
ACME_EMAIL=admin@example.org
BASE_URL=https://localhost
FRONTEND_URL=https://localhost
PUBLIC_API_BASE_URL=https://localhost/api
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- Database ---
POSTGRES_DB=dietnet
POSTGRES_USER=dietnet
POSTGRES_PASSWORD=change-me

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- CAPTCHA (Cloudflare Turnstile) ---
CAPTCHA_ENABLED=true
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# --- SMTP submission relay (port 587 -- Arbutus blocks outbound 25) ---
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.org

# --- Data retention ---
RETENTION_DAYS=30
DELETE_RAW_AFTER_SUCCESS=true

# --- Storage: where the encrypted Cinder volume is mounted on the host ---
DATA_HOST_PATH=./volumes

# --- Worker tuning ---
ENSEMBLE_WORKERS=1
ENVIRONMENT=production

# --- Concurrency caps (single-VM disk headroom -- see DEPLOYMENT.md) ---
CELERY_WORKER_CONCURRENCY=9   # max inference jobs processed in parallel
MAX_CONCURRENT_DOWNLOADS=9    # max simultaneous result-zip downloads

# --- Upload / job limits ---
MAX_UPLOAD_MB=1024       # combined size across all files in one upload, not per-file
MAX_SAMPLES=10000        # checked from the .fam after PLINK conversion
MIN_RELIABLE_SNP_OVERLAP=1000
MAX_ALLELE_MISMATCH_FRACTION=0.05  # fraction of overlapping SNPs allowed to be swapped/strand-flipped

# --- Shown on every rejection / error message, in the UI and in emails ---
GITHUB_ISSUES_URL=https://github.com/HussinLab/DIETNETWORK/issues
PUBLIC_GITHUB_ISSUES_URL=https://github.com/HussinLab/DIETNETWORK/issues
