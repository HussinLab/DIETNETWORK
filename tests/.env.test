# Env for the isolated test stack (tests/run_all.sh / docker-compose.test.yml).
# Dummy secrets are fine -- this stack is ephemeral, local-only, and never
# exposed beyond localhost:18000/18025. Not the same database/volume as
# any other dietnetwork deployment on this host (see DATA_HOST_PATH).
POSTGRES_DB=dietnet_test
POSTGRES_USER=dietnet_test
POSTGRES_PASSWORD=test-only-not-a-secret
JWT_SECRET=test-only-not-a-secret-jwt
DATA_HOST_PATH=./tests/.volumes-test

ENVIRONMENT=development
COOKIE_SECURE=false
CAPTCHA_ENABLED=false
BASE_URL=http://localhost:18000
FRONTEND_URL=http://localhost:18000

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_STARTTLS=false

# Kept on disk after a job succeeds, unlike the production default -- useful
# for inspecting a failed test run's raw upload after the fact.
DELETE_RAW_AFTER_SUCCESS=false
